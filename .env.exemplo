# Modelo de variáveis de ambiente do projeto.
# Copie este arquivo para ".env" e preencha os valores localmente.
# Este arquivo NUNCA deve conter valores reais — ver REGRAS_SEGURANCA.md.
#
# Ao adicionar uma nova variável de ambiente ao projeto, adicione a mesma
# chave aqui (vazia) no mesmo PR.

ANTHROPIC_API_KEY=
# Fallback: usado só se a chamada à Anthropic falhar (ex.: sem créditos).
GROQ_API_KEY=

# Banco do SafeOn (homologação). O cockpit só lê: a sessão roda com
# default_transaction_read_only. Mesmos nomes usados pelo safeon-api.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Opcional: restringe o cockpit a um tenant (customers.id). Vazio = agrega todos.
SAFEON_CUSTOMER_ID=
# Opcional: base do front do SafeOn usada nos links da busca global.
# Padrão: http://localhost:8080
SAFEON_APP_URL=
